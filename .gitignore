extracted/
build/
# m2c parse caches, written beside each --context file and regenerated
# whenever that file changes. Generated binary artifacts, never committed.
*.m2c
# `build/` also matches tools/build/. Keep this generated-profile source
# trackable without exposing unrelated local files in that directory.
!tools/build/
tools/build/*
!tools/build/genProjectProfile.ts
!tools/build/deriveTuOwnedGlobals.ts
!tools/build/deriveRodataSplits.ts
# Colocated tests for the build tools, which the npm test script runs.
!tools/build/*.test.ts
# Overlay container pipeline (plans/overlay-decompilation-enablement.md).
!tools/build/extractArchive.ts
!tools/build/classifyArchiveMembers.ts
!tools/build/solveOverlayBase.ts
!tools/build/bootstrapOverlay.ts
!tools/build/disassemble.ts
!tools/build/exportEngineSymbols.ts
!tools/build/genDisasmSymbols.ts
tools/vendor/old-gcc/build-gcc-*/
tools/vendor/homebrew-psyq/
