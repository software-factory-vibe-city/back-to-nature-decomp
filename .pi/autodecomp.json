{
  "runtimeDir": "run_output/autodecomp",
  "parallelism": 1,
  "requireCleanTrackedTree": true,
  "matching": {
    "models": [
      {
        "thinking": "high",
        "maxAttempts": 2
      }
    ],
    "turnLimit": 60,
    "timeoutMinutes": 90,
    "idleTimeoutMinutes": 15
