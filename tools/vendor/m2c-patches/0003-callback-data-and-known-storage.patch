+    def callback_table_type(self, sym: GlobalSymbol) -> Optional[Type]:
+        """Original .word function addresses establish callable storage, not a
+        uniform contract. Admit a concrete signature only if EVERY named entry
+        has that same complete context signature. Do not union-find conflicting
+        entry types: unify can partially mutate even on failure.
+        """
+        entry = sym.asm_data_entry
+        assert entry is not None
+        names = []
+        for word in entry.data:
+            name = word.as_symbol_without_addend() if isinstance(word, AsmSymbolicData) else None
+            if name is None or (name not in self.local_functions and name not in self.typemap.functions):
+                return None
+            names.append(name)
+        if not names:
+            return None
+        signatures = []
+        for name in names:
+            fn = self.typemap.functions.get(name)
+            if fn is None:
+                signatures.append(None)
+            else:
+                pointer = Type.ptr(Type.ctype(fn.type, self.typemap, self.typepool))
+                signature = pointer.get_function_pointer_signature()
+                signatures.append(pointer if signature is not None and signature.params_known else None)
+        complete = [p for p in signatures if p is not None]
+        shapes = {p.format(Formatter()) for p in complete}
+        if len(complete) == len(names) and len(shapes) == 1:
+            return Type.array(complete[0], len(names))
+        reason = "incompatible signatures" if len(shapes) > 1 else "incomplete contracts"
+        self.typepool.warnings.append(
+            f"Warning: callback table {sym.symbol_name}: {reason}; examined " + ", ".join(names)
+        )
+        sym.callback_table_unresolved = True
+        return Type.array(Type.ptr(Type.function()), len(names))
